# URL base do BFF (local) ou do API Gateway (nuvem). Sempre inclui o prefixo /api.
VITE_API_BASE_URL=http://localhost:3000/api
# Chave de assinatura do Azure API Management. Defina SOMENTE ao apontar para o gateway em
# nuvem: o httpClient envia o header Ocp-Apim-Subscription-Key em todas as chamadas.
# Deixe vazia no ambiente local (BFF direto). Fica visível no bundle: é chave de produto do
# APIM (rate-limit/identificação), não segredo; a autorização real é o JWT validado pelo BFF.
VITE_APIM_SUBSCRIPTION_KEY=
# dev = seletor de persona (POST /api/auth/dev-token) | entra = Microsoft Entra ID (MSAL)
VITE_AUTH_MODE=dev
# Somente no modo entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://open-prontuario-bff/acesso
